# --- Docker Compose project name ---
# Prefija todos los contenedores, redes y volúmenes del entorno.
# Cambia este valor para correr múltiples entornos en paralelo sin conflictos.
# Ejemplos: atreyu-dev, atreyu-agent1, atreyu-ci
COMPOSE_PROJECT_NAME=atreyu-library

# --- PostgreSQL (solo desarrollo local) ---
# En QA/prod NO se usan estas variables: Spring Boot recibe SPRING_DATASOURCE_URL completa
# (host + puerto + db) como una sola variable de entorno en Cloud Run.
# Ejemplo QA/prod: SPRING_DATASOURCE_URL=jdbc:postgresql://db.supabase.co:5432/atreyu
POSTGRES_DB=atreyu
POSTGRES_USER=atreyu
POSTGRES_PASSWORD=atreyu
POSTGRES_FW_PORT=5432   # puerto del host para acceso externo (pgAdmin, DBeaver); el interno siempre es 5432

# --- Backend (Spring Boot) ---
BACKEND_PORT=8080
ACTUATOR_SHOW_DETAILS=always

# --- Frontend (Angular dev server) ---
FRONTEND_PORT=4200

# --- pgAdmin (solo desarrollo local — QA/prod usan Supabase) ---
# PGADMIN_EMAIL y PGADMIN_PASSWORD son obligatorios — no tienen valor por defecto en docker-compose
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@atreyu.dev
PGADMIN_PASSWORD=admin
