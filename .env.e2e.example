# ─────────────────────────────────────────────────────────────────────────────
# E2E environment — local only
# Copy this file to .env.e2e and adjust values if needed.
# .env.e2e is gitignored y nunca debe commitearse.
# ─────────────────────────────────────────────────────────────────────────────

# Puerto expuesto del frontend E2E
E2E_FRONTEND_PORT=4200

# Puerto expuesto del backend E2E (evita conflicto con dev en 8080)
E2E_BACKEND_PORT=8081

# Puerto expuesto de Postgres E2E (evita conflicto con dev en 5432)
E2E_POSTGRES_PORT=5433

# Credenciales de la DB E2E (solo usadas localmente, no son datos reales)
E2E_DB_NAME=atreyu_e2e
E2E_DB_USER=atreyu_e2e
E2E_DB_PASSWORD=atreyu_e2e

# Badge de ambiente que Cypress inyecta en el smoke test para validar el título del navegador
ENV_BADGE=🔵

# URL base que Cypress usará — se construye automáticamente desde E2E_FRONTEND_PORT.
# Solo define esto si necesitas un override explícito (ej. HTTPS o dominio distinto).
# CYPRESS_BASE_URL=http://localhost:4200
