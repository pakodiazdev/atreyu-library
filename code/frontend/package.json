{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "e2e:up": "docker compose --env-file ../../.env.e2e -f ../../docker-compose.e2e.yml up -d --build",
    "e2e:down": "docker compose --env-file ../../.env.e2e -f ../../docker-compose.e2e.yml down -v",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:open:e2e": "dotenv -e ../../.env.e2e -- cypress open",
    "cy:run:e2e": "dotenv -e ../../.env.e2e -- cypress run",
    "cy:run:headed": "dotenv -e ../../.env.e2e -- cypress run --headed --no-exit"
  },
  "private": true,
  "packageManager": "npm@11.6.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@sentry/angular": "^10.53.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.3.1",
    "@angular-eslint/eslint-plugin": "^21.3.1",
    "@angular-eslint/eslint-plugin-template": "^21.3.1",
    "@angular-eslint/template-parser": "^21.3.1",
    "@angular/build": "^21.2.10",
    "@angular/cli": "^21.2.10",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.5",
    "cypress": "^15.15.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.0.8"
  }
}
